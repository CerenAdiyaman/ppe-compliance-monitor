# Copy to .env and fill in. All variables use the HG_ prefix.
# Add new entries here as the code starts reading them.

# --- training / dataset (notebooks only) ---
# Roboflow API key used by notebooks/HardHatDetection.ipynb
HG_ROBOFLOW_API_KEY=

# --- ingestion ---
# Webcam index ("0"), a file path, or an rtsp://user:pass@host/stream URL.
HG_VIDEO_SOURCE=0
# Webcam capture backend: auto | any | dshow | msmf.
# On Windows, `dshow` avoids an ~8s probe when Media Foundation cannot stream.
HG_CAPTURE_BACKEND=auto

# --- detection ---
HG_MODEL_PATH=models/best.pt
HG_CONFIDENCE_THRESHOLD=0.45
# cpu | cuda | cuda:0
HG_DEVICE=cpu

# --- violation rules ---
HG_CONFIRMATION_FRAMES=5
HG_COOLDOWN_SECONDS=60

# --- privacy ---
# Blur faces before a snapshot is written to disk or emailed.
HG_ANONYMIZE_FACES=true

# --- storage ---
# HG_DATABASE_URL=sqlite:///data/violations.db
# HG_VIOLATIONS_DIR=data/violations

# --- notification ---
# Gmail needs a 16-character app password, not the account password.
HG_SMTP_HOST=smtp.gmail.com
HG_SMTP_PORT=465
HG_SMTP_USER=your.address@gmail.com
HG_SMTP_PASSWORD=your_16_char_app_password
HG_ALERT_RECIPIENT=safety.officer@company.com
HG_NOTIFICATIONS_ENABLED=false
